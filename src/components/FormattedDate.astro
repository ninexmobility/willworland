---
interface Props {
  date: Date;
  format?: "long" | "short" | "iso";
  class?: string;
}

const { date, format = "long", class: className = "" } = Astro.props;

const display =
  format === "iso"
    ? date.toISOString().slice(0, 10)
    : date.toLocaleDateString("en-US", {
        year: "numeric",
        month: format === "long" ? "long" : "short",
        day: "numeric",
      });
---

<time
  datetime={date.toISOString()}
  class:list={["font-mono text-xs uppercase tracking-wider text-ink-500 dark:text-ink-400", className]}
>
  {display}
</time>
