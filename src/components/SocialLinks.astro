---
import { socials } from "~/data/socials";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<ul
  class:list={[
    "flex items-center gap-1",
    className,
  ]}
>
  {
    socials.map((s) => (
      <li>
        <a
          href={s.href}
          aria-label={s.label}
          class="inline-flex h-9 w-9 items-center justify-center rounded-md text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-900 dark:text-ink-400 dark:hover:bg-ink-800 dark:hover:text-ink-100"
          {...s.href.startsWith("http")
            ? { target: "_blank", rel: "noopener noreferrer" }
            : {}}
        >
          <Icon name={s.icon} />
        </a>
      </li>
    ))
  }
</ul>
