---
interface Props {
  label: string;
  size?: "sm" | "xs";
}
const { label, size = "sm" } = Astro.props;

const sizeClass =
  size === "xs" ? "text-[10px] px-1.5 py-0.5" : "text-xs px-2 py-0.5";
---

<span
  class:list={[
    "inline-flex items-center rounded font-mono uppercase tracking-wider",
    "border border-ink-200 bg-ink-100 text-ink-600",
    "dark:border-ink-800 dark:bg-ink-900 dark:text-ink-400",
    sizeClass,
  ]}
>
  {label}
</span>
