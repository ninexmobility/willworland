---
import type { ProjectCard } from "~/data/projects";
import Tag from "./Tag.astro";
import Icon from "./Icon.astro";

interface Props {
  project: ProjectCard;
}

const { project } = Astro.props;
const isExternal = project.link?.startsWith("http") ?? false;
---

<article
  class="group flex flex-col overflow-hidden rounded-md border border-ink-200 bg-white transition-colors hover:border-ink-300 dark:border-ink-800 dark:bg-ink-900/40 dark:hover:border-ink-700"
>
  <a
    href={project.link ?? "#"}
    {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
    class="block overflow-hidden"
    aria-label={`Open ${project.title}`}
  >
    <img
      src={project.coverImage.src}
      alt={project.coverImage.alt}
      loading="lazy"
      decoding="async"
      class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />
  </a>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-base font-semibold text-ink-900 dark:text-ink-50">
        <a
          href={project.link ?? "#"}
          {...isExternal
            ? { target: "_blank", rel: "noopener noreferrer" }
            : {}}
          class="group-hover:text-accent-600 dark:group-hover:text-accent-300"
        >
          {project.title}
        </a>
      </h3>
      {
        project.timeframe && (
          <span class="shrink-0 font-mono text-xs uppercase tracking-wider text-ink-500 dark:text-ink-400">
            {project.timeframe}
          </span>
        )
      }
    </div>

    <p class="flex-1 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
      {project.description}
    </p>

    <div class="flex flex-wrap gap-1.5">
      {project.tech.map((t) => <Tag label={t} size="xs" />)}
    </div>

    <div class="flex items-center gap-4 pt-1 text-xs font-medium">
      {
        project.link && (
          <a
            href={project.link}
            {...isExternal
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {}}
            class="inline-flex items-center gap-1 text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-300 dark:hover:text-accent-200"
          >
            {isExternal ? "Visit site" : "Details"}
            <Icon
              name={isExternal ? "external" : "arrow-right"}
              class="h-3 w-3"
            />
          </a>
        )
      }
      {
        project.repo && (
          <a
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-ink-600 transition-colors hover:text-ink-900 dark:text-ink-300 dark:hover:text-ink-100"
          >
            Repo
            <Icon name="external" class="h-3 w-3" />
          </a>
        )
      }
    </div>
  </div>
</article>
