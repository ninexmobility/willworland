---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Tag from "~/components/Tag.astro";
import Icon from "~/components/Icon.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  summary,
  tags,
  cover,
  coverAlt,
  highlights,
  images,
  inlineImages,
} = project.data;
---

<BaseLayout title={title} description={summary} image={cover} imageAlt={coverAlt}>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <a
      href="/projects"
      class="mb-6 inline-flex items-center gap-1.5 text-xs font-medium text-ink-500 transition-colors hover:text-accent-600 dark:text-ink-400 dark:hover:text-accent-300"
    >
      <Icon name="arrow-left" class="h-3 w-3" />
      Back to projects
    </a>

    <header class="space-y-3">
      <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-ink-50">
        {title}
      </h1>
      <div
        class="prose-post text-base leading-relaxed text-ink-600 dark:text-ink-300"
        id="project-summary"
      >
        <Content />
      </div>
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((t) => (
              <Tag label={t} />
            ))}
          </div>
        )
      }
    </header>

    {/* Hero image */}
    {
      images.length > 0 && (
        <figure class="mt-8">
          <img
            src={images[0].src}
            alt={images[0].alt}
            class="w-full rounded-md border border-ink-200 object-cover dark:border-ink-800"
          />
          {images[0].caption && (
            <figcaption class="mt-2 text-xs text-ink-500 dark:text-ink-400">
              {images[0].caption}
            </figcaption>
          )}
        </figure>
      )
    }

    {/* Highlights */}
    {
      highlights.length > 0 && (
        <section class="mt-10 space-y-3">
          <h2 class="border-b border-ink-200 pb-2 text-sm font-medium uppercase tracking-wider text-ink-500 dark:border-ink-800 dark:text-ink-400">
            Highlights
          </h2>
          <ul class="space-y-3 pt-2">
            {highlights.map((item) =>
              typeof item === "string" ? (
                <li class="flex gap-2 text-sm leading-relaxed text-ink-700 dark:text-ink-200">
                  <span aria-hidden="true" class="text-ink-400">
                    •
                  </span>
                  <span>{item}</span>
                </li>
              ) : (
                <li class="space-y-1.5">
                  <p class="flex gap-2 text-sm leading-relaxed text-ink-700 dark:text-ink-200">
                    <span aria-hidden="true" class="text-ink-400">
                      •
                    </span>
                    <span>{item.text}</span>
                  </p>
                  {item.subpoints.length > 0 && (
                    <ul class="ml-5 list-disc space-y-0.5 pl-4 text-sm text-ink-600 dark:text-ink-300">
                      {item.subpoints.map((sub) => (
                        <li>{sub}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ),
            )}
          </ul>
        </section>
      )
    }

    {/* Gallery */}
    {
      images.length > 1 && (
        <section class="mt-10 space-y-3">
          <h2 class="border-b border-ink-200 pb-2 text-sm font-medium uppercase tracking-wider text-ink-500 dark:border-ink-800 dark:text-ink-400">
            Gallery
          </h2>
          <div class="grid grid-cols-1 gap-3 pt-2 sm:grid-cols-2 lg:grid-cols-3">
            {images.slice(1).map((img) => (
              <button
                type="button"
                class="group block overflow-hidden rounded-md border border-ink-200 bg-white text-left transition-colors hover:border-accent-500 dark:border-ink-800 dark:bg-ink-900/40 dark:hover:border-accent-400"
                data-lightbox-src={img.src}
                data-lightbox-alt={img.alt}
                data-lightbox-caption={img.caption ?? ""}
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                />
                {img.caption && (
                  <p class="px-3 py-2 text-xs text-ink-500 dark:text-ink-400">
                    {img.caption}
                  </p>
                )}
              </button>
            ))}
          </div>
        </section>
      )
    }

    {/* Inline image data (for lightbox linking) */}
    {
      inlineImages.length > 0 && (
        <script
          type="application/json"
          id="inline-images-data"
          set:html={JSON.stringify(inlineImages)}
        />
      )
    }
  </div>

  {/* Lightbox dialog */}
  <dialog
    id="lightbox"
    class="m-auto w-[min(960px,calc(100vw-2rem))] rounded-md border border-ink-200 bg-white p-0 backdrop:bg-ink-950/70 dark:border-ink-800 dark:bg-ink-900"
  >
    <button
      type="button"
      id="lightbox-close"
      aria-label="Close image"
      class="absolute right-3 top-3 z-10 inline-flex h-9 w-9 items-center justify-center rounded-md bg-white/90 text-ink-700 backdrop-blur transition-colors hover:bg-white hover:text-ink-900 dark:bg-ink-800/90 dark:text-ink-200 dark:hover:bg-ink-800 dark:hover:text-ink-50"
    >
      <Icon name="close" />
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="block max-h-[75vh] w-full object-contain"
    />
    <div id="lightbox-meta" class="space-y-2 px-4 py-3 text-sm">
      <p id="lightbox-caption" class="text-ink-600 dark:text-ink-300"></p>
      <a
        id="lightbox-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden text-xs font-medium text-accent-600 hover:text-accent-700 dark:text-accent-300 dark:hover:text-accent-200"
      >
        View source ↗
      </a>
    </div>
  </dialog>

  <script is:inline>
    (() => {
      const dialog = document.getElementById("lightbox");
      if (!(dialog instanceof HTMLDialogElement)) return;

      const imgEl = document.getElementById("lightbox-img");
      const captionEl = document.getElementById("lightbox-caption");
      const linkEl = document.getElementById("lightbox-link");
      const closeBtn = document.getElementById("lightbox-close");

      const open = ({ src, alt, caption, link }) => {
        if (!(imgEl instanceof HTMLImageElement)) return;
        imgEl.src = src;
        imgEl.alt = alt || "";
        if (captionEl) captionEl.textContent = caption || "";
        if (linkEl instanceof HTMLAnchorElement) {
          if (link) {
            linkEl.href = link;
            linkEl.classList.remove("hidden");
          } else {
            linkEl.classList.add("hidden");
          }
        }
        dialog.showModal();
      };

      // Gallery thumbnails
      document.querySelectorAll("[data-lightbox-src]").forEach((btn) => {
        btn.addEventListener("click", () => {
          open({
            src: btn.getAttribute("data-lightbox-src") || "",
            alt: btn.getAttribute("data-lightbox-alt") || "",
            caption: btn.getAttribute("data-lightbox-caption") || "",
          });
        });
      });

      // Inline image hash links (from MDX summary): href="#image-<id>"
      const inlineDataEl = document.getElementById("inline-images-data");
      const inlineImages = inlineDataEl?.textContent
        ? JSON.parse(inlineDataEl.textContent)
        : [];

      document
        .getElementById("project-summary")
        ?.addEventListener("click", (e) => {
          const target = e.target;
          if (!(target instanceof HTMLElement)) return;
          const anchor = target.closest("a");
          if (!(anchor instanceof HTMLAnchorElement)) return;
          const hash = anchor.getAttribute("href") || "";
          const m = hash.match(/^#image-(.+)$/);
          if (!m) return;
          const id = m[1];
          const match = inlineImages.find((i) => i.id === id);
          if (!match) return;
          e.preventDefault();
          open(match);
        });

      closeBtn?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (e) => {
        // Close when clicking on the backdrop (not the content)
        if (e.target === dialog) dialog.close();
      });
    })();
  </script>
</BaseLayout>
