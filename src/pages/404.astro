---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Icon from "~/components/Icon.astro";
---

<BaseLayout title="Not found" noindex>
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-xs uppercase tracking-wider text-ink-500 dark:text-ink-400">
      404
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-ink-900 sm:text-5xl dark:text-ink-50">
      Page not found
    </h1>
    <p class="mt-3 max-w-md text-base text-ink-600 dark:text-ink-300">
      The page you were looking for moved, was renamed, or never existed in the
      first place. Try one of these instead:
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 rounded-md bg-accent-500 px-3.5 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-600"
      >
        <Icon name="arrow-left" class="h-3.5 w-3.5" />
        Home
      </a>
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 rounded-md border border-ink-300 px-3.5 py-2 text-sm font-medium text-ink-700 transition-colors hover:border-ink-400 hover:text-ink-900 dark:border-ink-700 dark:text-ink-200 dark:hover:border-ink-600 dark:hover:text-ink-50"
      >
        Blog
      </a>
      <a
        href="/resume"
        class="inline-flex items-center gap-1.5 rounded-md border border-ink-300 px-3.5 py-2 text-sm font-medium text-ink-700 transition-colors hover:border-ink-400 hover:text-ink-900 dark:border-ink-700 dark:text-ink-200 dark:hover:border-ink-600 dark:hover:text-ink-50"
      >
        Resume
      </a>
    </div>
  </div>
</BaseLayout>
