---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { resume } from "~/data/resume";
import { contact } from "~/data/socials";
import PostCard from "~/components/PostCard.astro";
import Icon from "~/components/Icon.astro";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const quickLinks = [
  {
    href: "/projects",
    label: "Projects",
    description: "Things I've built and shipped.",
  },
  {
    href: "/uses",
    label: "Uses",
    description: "Hardware, software, and tools in my daily stack.",
  },
  {
    href: "/resume",
    label: "Resume",
    description: "25+ years of enterprise mobility and systems experience.",
  },
];
---

<BaseLayout>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-16">
    {/* Hero */}
    <section class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <img
        src="/will.png"
        alt={resume.name}
        width="128"
        height="128"
        class="h-24 w-24 shrink-0 rounded-full border-2 border-accent-500 object-cover sm:h-32 sm:w-32"
      />
      <div class="space-y-4">
        <div class="space-y-1">
          <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-ink-50">
            {resume.name}
          </h1>
          <p class="font-mono text-sm text-ink-500 dark:text-ink-400">
            {resume.title}
          </p>
          <p class="font-mono text-xs uppercase tracking-wider text-ink-400 dark:text-ink-500">
            {resume.location} · <a
              href={contact.phoneHref}
              class="hover:text-accent-600 dark:hover:text-accent-300"
              >{contact.phoneDisplay}</a
            >
          </p>
        </div>

        <p class="max-w-prose text-base leading-relaxed text-ink-700 dark:text-ink-300">
          Founder of <span class="font-medium text-ink-900 dark:text-ink-100"
            >Oak &amp; Ash Technology</span
          >. I write about enterprise mobility, device management automation,
          and the tools that make modern IT infrastructure work at scale.
        </p>

        <div class="flex flex-wrap items-center gap-2">
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 rounded-md bg-accent-500 px-3.5 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-600"
          >
            Read the blog
            <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </a>
          <a
            href="/resume"
            class="inline-flex items-center gap-1.5 rounded-md border border-ink-300 bg-transparent px-3.5 py-2 text-sm font-medium text-ink-700 transition-colors hover:border-ink-400 hover:text-ink-900 dark:border-ink-700 dark:text-ink-200 dark:hover:border-ink-600 dark:hover:text-ink-50"
          >
            Full resume
          </a>
        </div>
      </div>
    </section>

    {/* Recent writing */}
    <section class="mt-16 space-y-5">
      <div class="flex items-baseline justify-between">
        <h2 class="text-sm font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
          Recent writing
        </h2>
        <a
          href="/blog"
          class="inline-flex items-center gap-1 text-xs font-medium text-accent-600 hover:text-accent-700 dark:text-accent-300 dark:hover:text-accent-200"
        >
          All posts
          <Icon name="arrow-right" class="h-3 w-3" />
        </a>
      </div>
      <div class="space-y-3">
        {recentPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    {/* Explore */}
    <section class="mt-16 space-y-5">
      <h2 class="text-sm font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
        Explore
      </h2>
      <div class="grid gap-3 sm:grid-cols-3">
        {
          quickLinks.map((q) => (
            <a
              href={q.href}
              class="group rounded-md border border-ink-200 bg-white p-4 transition-colors hover:border-accent-500 dark:border-ink-800 dark:bg-ink-900/40 dark:hover:border-accent-400"
            >
              <div class="flex items-center justify-between">
                <span class="font-semibold text-ink-900 dark:text-ink-50">
                  {q.label}
                </span>
                <Icon
                  name="arrow-right"
                  class="h-3.5 w-3.5 text-ink-400 transition-transform group-hover:translate-x-0.5 group-hover:text-accent-500"
                />
              </div>
              <p class="mt-1.5 text-sm text-ink-600 dark:text-ink-300">
                {q.description}
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
