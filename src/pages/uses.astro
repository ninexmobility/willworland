---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Icon from "~/components/Icon.astro";
import { usesData } from "~/data/uses";
---

<BaseLayout
  title="Uses"
  description="The hardware, software, and tools I rely on day-to-day."
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <header class="mb-10 space-y-3">
      <p class="font-mono text-xs uppercase tracking-wider text-ink-500 dark:text-ink-400">
        /uses
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl dark:text-ink-50">
        Tools I use
      </h1>
      <p class="text-base leading-relaxed text-ink-600 dark:text-ink-300">
        Inspired by{" "}
        <a
          href="https://uses.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 hover:text-accent-600 dark:hover:text-accent-300"
          >uses.tech</a
        >
         — the gear, software, and editor stack that backs the day-to-day.
      </p>
    </header>

    <div class="space-y-12">
      {
        usesData.map((cat) => (
          <section>
            <h2 class="border-b border-ink-200 pb-2 text-sm font-medium uppercase tracking-wider text-ink-500 dark:border-ink-800 dark:text-ink-400">
              {cat.title}
            </h2>
            {cat.description && (
              <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
                {cat.description}
              </p>
            )}
            <ul class="mt-4 space-y-3">
              {cat.items.map((item) => (
                <li class="grid grid-cols-1 gap-1 rounded-md border border-ink-200 bg-white px-4 py-3 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-4 dark:border-ink-800 dark:bg-ink-900/40">
                  <div>
                    {item.url ? (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 font-medium text-ink-900 hover:text-accent-600 dark:text-ink-50 dark:hover:text-accent-300"
                      >
                        {item.name}
                        <Icon name="external" class="h-3 w-3 opacity-60" />
                      </a>
                    ) : (
                      <span class="font-medium text-ink-900 dark:text-ink-50">
                        {item.name}
                      </span>
                    )}
                    <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-300">
                      {item.description}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
