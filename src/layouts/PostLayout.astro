---
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "~/components/FormattedDate.astro";
import Tag from "~/components/Tag.astro";
import Giscus from "~/components/Giscus.astro";
import Icon from "~/components/Icon.astro";

interface Props {
  title: string;
  date: Date;
  summary: string;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
  coverCredit?: { name: string; url: string };
}

const { title, date, summary, tags = [], cover, coverAlt, coverCredit } = Astro.props;
---

<BaseLayout
  title={title}
  description={summary}
  image={cover}
  imageAlt={coverAlt}
  type="article"
  publishedTime={date.toISOString()}
>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <a
      href="/blog"
      class="mb-8 inline-flex items-center gap-1.5 text-xs font-medium text-ink-500 transition-colors hover:text-accent-600 dark:text-ink-400 dark:hover:text-accent-300"
    >
      <Icon name="arrow-left" class="h-3 w-3" />
      Back to blog
    </a>

    <header class="mb-10 space-y-4">
      <FormattedDate date={date} />
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-ink-900 sm:text-4xl dark:text-ink-50">
        {title}
      </h1>
      <p class="text-lg leading-relaxed text-ink-600 dark:text-ink-300">
        {summary}
      </p>
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((t) => (
              <Tag label={t} />
            ))}
          </div>
        )
      }
    </header>

    {
      cover && (
        <figure class="mb-10">
          <img
            src={cover}
            alt={coverAlt ?? title}
            class="w-full rounded-md border border-ink-200 dark:border-ink-800"
          />
          {coverCredit && (
            <figcaption class="mt-2 text-xs text-ink-500 dark:text-ink-400">
              Photo by{" "}
              <a
                href={coverCredit.url}
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-2 hover:text-accent-600 dark:hover:text-accent-300"
              >
                {coverCredit.name}
              </a>
            </figcaption>
          )}
        </figure>
      )
    }

    <div class="prose-post">
      <slot />
    </div>

    <Giscus />
  </article>
</BaseLayout>
